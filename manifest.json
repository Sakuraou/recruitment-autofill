{
  "manifest_version": 3,
  "name": "校招智能网申助手 · 2027",
  "version": "0.6.14",
  "description": "从本地档案识别并补全网申表单；支持通用字段、项目连续填写试用和中国移动多栏目流程。最终投递由本人完成。",
  "minimum_chrome_version": "114",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": { "default_popup": "popup.html", "default_title": "校招智能网申助手" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "background": { "service_worker": "background.js", "type": "module" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'; connect-src http://127.0.0.1:43127" }
}
