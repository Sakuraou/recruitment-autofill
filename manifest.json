{
  "manifest_version": 3,
  "name": "校招智能网申助手 · 2027",
  "version": "0.6.61",
  "description": "从本地档案补全网申表单；支持多类经历连续填写、模型语义识别与受控截图后备，最终投递由本人完成。",
  "minimum_chrome_version": "114",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "校招智能网申助手"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src http://127.0.0.1:43127"
  }
}
